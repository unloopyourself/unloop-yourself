{
  "expo": {
    "name": "Unloop",
    "slug": "unloop",
    "version": "0.1.1",
    "scheme": "unloop",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A2540"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "io.github.unloopyourself.unloop",
      "versionCode": 3,
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#0A2540",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Unloop needs photo access so you can send a short buddy nudge picture. Photos are not uploaded to a permanent gallery — only a short-lived relay blob for this interrupt.",
          "cameraPermission": "Unloop needs the camera so you can send a short buddy nudge picture for this interrupt only."
        }
      ],
      "./plugins/withUnloopAndroidRelease.js",
      "expo-asset",
      "expo-audio"
    ]
  }
}
